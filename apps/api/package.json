{
  "name": "@copilot/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint src drizzle.config.ts vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "demo:agent": "tsx src/development/demo-agent.ts",
    "db:migrate:runtime": "node dist/database/migrate.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@copilot/contracts": "workspace:*",
    "@copilot/database": "workspace:*",
    "@copilot/messaging": "workspace:*",
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/swagger": "11.4.5",
    "crypto-js": "4.2.0",
    "drizzle-orm": "0.45.2",
    "helmet": "8.2.0",
    "pg": "8.22.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.1.28",
    "@types/pg": "8.20.0",
    "@types/crypto-js": "4.2.2",
    "@types/supertest": "7.2.0",
    "dotenv": "17.4.1",
    "drizzle-kit": "0.31.10",
    "supertest": "7.2.2",
    "tsx": "4.23.0",
    "vitest": "4.1.10"
  }
}
