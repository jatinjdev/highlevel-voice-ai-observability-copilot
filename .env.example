# Local-only HighLevel fallback. Omit both values in production.
SUB_ACCOUNT_LOCATION_ID=your_location_id
SUB_ACCOUNT_PIT=your_private_integration_token

# HighLevel Marketplace OAuth. Generate the encryption key with:
# openssl rand -base64 32
HIGHLEVEL_CLIENT_ID=your_marketplace_client_id
HIGHLEVEL_CLIENT_SECRET=your_marketplace_client_secret
HIGHLEVEL_APP_ID=your_marketplace_app_id
HIGHLEVEL_REDIRECT_URI=https://your-public-origin.example/api/leadconnector/oauth
HIGHLEVEL_POST_INSTALL_REDIRECT_URI=https://your-public-origin.example/
HIGHLEVEL_TOKEN_ENCRYPTION_KEY=your_base64_encoded_32_byte_key
# Generate this in Marketplace App > Advanced > Auth > Shared Secret.
HIGHLEVEL_APP_SHARED_SECRET=your_marketplace_shared_secret

# API
NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:5173

# PostgreSQL
DATABASE_URL=postgresql://copilot:copilot@localhost:5432/copilot

# Asynchronous processing. Point SQS_ENDPOINT at LocalStack only in local development.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_INGESTION_QUEUE_URL=http://localhost:4566/000000000000/copilot-ingestion
SQS_ANALYSIS_QUEUE_URL=http://localhost:4566/000000000000/copilot-analysis
SQS_ENDPOINT=http://localhost:4566
OUTBOX_PUBLISHER_ENABLED=false

# Leave the provider disabled for deterministic-only local pipeline tests.
LLM_PROVIDER=none
LLM_PROVIDER_ID=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5.6
LLM_STRUCTURED_OUTPUT_MODE=json_schema
LLM_MAX_OUTPUT_TOKENS=8192
# Optional because some OpenAI-compatible models do not accept sampling controls.
LLM_TEMPERATURE=0
LLM_REQUEST_TIMEOUT_MS=180000
LLM_EXTRA_BODY_JSON={}
# Required for authenticated providers; local servers may omit it.
# LLM_API_KEY=store_this_in_aws_secrets_manager

# Browser-safe frontend configuration
VITE_API_BASE_URL=/api
