{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://copilot.local/schemas/highlevel-voice-ai-suggestion-catalogue.schema.json",
  "title": "HighLevel Voice AI suggestion catalogue",
  "type": "object",
  "required": ["version", "tiers", "sources", "suggestions"],
  "properties": {
    "version": { "type": "string", "minLength": 1 },
    "tiers": {
      "type": "object",
      "required": ["primary", "feature", "advanced"],
      "additionalProperties": {
        "type": "object",
        "required": ["description"],
        "properties": { "description": { "type": "string", "minLength": 1 } }
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["title", "url"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri" }
        }
      }
    },
    "suggestions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "tier",
          "category",
          "title",
          "uiPath",
          "applicationMode",
          "api",
          "evidencePolicy",
          "requiredEvidence",
          "signals",
          "guardrails",
          "validation",
          "sourceIds"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
          "tier": { "enum": ["primary", "feature", "advanced"] },
          "category": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "uiPath": { "type": "string", "minLength": 1 },
          "applicationMode": {
            "enum": ["api_or_manual_ui", "separate_public_api", "manual_ui_only"]
          },
          "api": {
            "type": "object",
            "required": ["status"],
            "properties": {
              "status": { "enum": ["documented_write", "partial", "undocumented"] },
              "field": { "type": ["string", "null"] },
              "scope": { "type": ["string", "null"] }
            }
          },
          "evidencePolicy": { "enum": ["single_call_can_suffice", "pattern_preferred"] },
          "requiredEvidence": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "signals": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "guardrails": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "validation": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "sourceIds": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
